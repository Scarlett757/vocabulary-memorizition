# 部署凭据模板：复制为 .env 后填入真实值（.env 不进 git / 不进 Docker 镜像）
# Docker 部署推荐：直接在 docker-compose.yml 的 environment 字段填写

# Flask 密钥（务必改为随机强密钥：python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=please-change-to-random-strong-secret

# MySQL 数据库
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=vocab_app
MYSQL_PASSWORD=please-change-me
MYSQL_DATABASE=vocabulary_memorization

# 邮箱 SMTP（QQ 邮箱示例）
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-authorization-code
MAIL_FROM=显示发件人

# Ollama（可选，不配置则翻译接口返回 502，不影响主流程）
OLLAMA_MODEL=qwen2.5:7b
